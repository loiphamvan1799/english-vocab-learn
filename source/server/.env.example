# ─── Môi trường ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Port server ────────────────────────────────────────────────────────────
PORT=4000

# ─── CORS — Origins được phép gọi API ───────────────────────────────────────
# Local dev: frontend chạy ở port 3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ────────────────────────────────────────────────────────────────
#
# LOCAL (offline, mặc định): Không cần điền 2 dòng dưới.
# Server tự dùng file SQLite tại data/vocabulary.db
#
# TURSO CLOUD (production hoặc test với cloud DB):
# Bỏ comment và điền thông tin lấy từ https://turso.tech/dashboard
#
# TURSO_DATABASE_URL=libsql://ten-database-username.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSJ9.YOUR_TOKEN_HERE

# ─── Giới hạn upload ─────────────────────────────────────────────────────────
# IMPORT_HTML_MAX_BYTES=2097152    # 2 MB
# IMPORT_MEDIA_MAX_BYTES=10485760  # 10 MB
# IMPORT_TOTAL_MAX_BYTES=52428800  # 50 MB
